NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=change-this-to-a-long-random-string-min-64-chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Database
DB_PATH=./data/pccc.db

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Bcrypt
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
